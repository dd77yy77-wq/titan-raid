package com.titanraid.game2d;
import android.graphics.*; import java.awt.image.BufferedImage; import javax.imageio.ImageIO; import java.io.File;
public class CT { 
  static Bitmap bm(int w,int h){ return Bitmap.createBitmap(w,h,Bitmap.Config.ARGB_8888); }
  public static void main(String[] a) throws Exception {
    long t0=System.currentTimeMillis(); ChestGfx.ensure(); System.out.println("chest bake ms "+(System.currentTimeMillis()-t0));
    int W=1200,H=420; Bitmap b=bm(W,H); Canvas c=new Canvas(b.im); Paint p=new Paint(); p.color=0xff0e0c1c; c.drawRect(0,0,W,H,p);
    float[] op={0,0.3f,0.6f,1f};
    for(int i=0;i<4;i++){ c.save(); c.translate(150+i*300,250); ChestGfx.drawChest(c,230f,op[i],1.3f,2f); c.restore(); }
    ImageIO.write(b.im,"png",new File("chest.png"));
    t0=System.currentTimeMillis(); for(int i=0;i<10;i++) ShipGfx.prewarmSync(i); System.out.println("ship bake ms "+(System.currentTimeMillis()-t0));
    for(int row=0;row<2;row++){ Bitmap s=bm(1500,380); Canvas k=new Canvas(s.im); Paint q=new Paint(); q.color=0xff12162c; k.drawRect(0,0,1500,380,q);
      Paint pp=new Paint(Paint.ANTI_ALIAS_FLAG);
      for(int i=0;i<5;i++){ int sh=row*5+i; k.save(); ShipArt.draw(k,pp,new Path(),sh,150+i*300,170,6.5f,0.7f,0.8f); k.restore();
        }
      ImageIO.write(s.im,"png",new File("ships"+row+".png"));
      Bitmap s2=bm(1500,380); Canvas k2=new Canvas(s2.im); k2.drawRect(0,0,1500,380,q);
      for(int i=0;i<5;i++){ int sh=row*5+i; ShipArt.drawFlat(k2,pp,new Path(),sh,150+i*300,170,6.5f,0.7f,0.8f); }
      ImageIO.write(s2.im,"png",new File("flat"+row+".png")); }
  }}
