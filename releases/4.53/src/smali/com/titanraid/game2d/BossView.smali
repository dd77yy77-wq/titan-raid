    const-string v2, "\u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b: \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u044b, \u043f\u043b\u0430\u0437\u043c\u0430, \u0434\u0443\u0433\u0430"

    const-string v3, "\u0414\u0432\u043e\u0439\u043d\u044b\u0435 \u043f\u043b\u0430\u0437\u043c\u0430 \u0438 \u0434\u0443\u0433\u0430, \u043b\u0430\u0437\u0435\u0440\u044b"

    const-string v4, "\u0422\u0440\u043e\u0439\u043d\u044b\u0435 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b, \u043f\u044f\u0442\u044c \u043b\u0430\u0437\u0435\u0440\u043e\u0432"

    const-string v5, "\u041f\u0440\u0438\u0437\u0440\u0430\u043a: \u043d\u0435\u0443\u044f\u0437\u0432\u0438\u043c 2,6 \u0441 \u043f\u043e\u0441\u043b\u0435 \u0443\u0434\u0430\u0440\u0430; \u043a\u043d\u043e\u043f\u043a\u0430 \u00ab\u0429\u0438\u0442\u00bb (10 \u0441, \u043f\u0435\u0440\u0435\u0437\u0430\u0440\u044f\u0434\u043a\u0430 30 \u0441)"

    const-string v6, "\u0416\u043d\u0435\u0446: \u0437\u043e\u043b\u043e\u0442\u043e \u00d71,5; \u043a\u043d\u043e\u043f\u043a\u0438 \u00ab\u0429\u0438\u0442\u00bb \u0438 \u00ab\u041d\u043e\u0432\u0430\u00bb (\u043f\u043e 10 \u0441, \u043f\u0435\u0440\u0435\u0437\u0430\u0440\u044f\u0434\u043a\u0430 30 \u0441)"

    const-string v7, "\u0414\u0440\u0435\u0434\u043d\u043e\u0443\u0442: \u0449\u0438\u0442 \u0431\u044b\u0441\u0442\u0440\u0435\u0435 \u0432\u0434\u0432\u043e\u0435; \u043a\u043d\u043e\u043f\u043a\u0438 \u00ab\u0429\u0438\u0442\u00bb \u0438 \u00ab\u041d\u043e\u0432\u0430\u00bb"

    const-string v8, "\u041f\u0440\u0438\u0437\u043c\u0430: \u0441\u0438\u043b\u044c\u043d\u0435\u0439\u0448\u0438\u0439 \u0443\u0440\u043e\u043d, \u043a\u043d\u043e\u043f\u043a\u0438 \u00ab\u0429\u0438\u0442\u00bb \u0438 \u00ab\u041d\u043e\u0432\u0430\u00bb \u2014 \u043a\u043e\u0440\u0430\u0431\u043b\u044c \u0434\u043b\u044f \u041c\u0438\u0440\u0430 3"

    const-string v9, "\u041a\u0432\u0430\u0437\u0430\u0440: \u0435\u0449\u0451 \u043c\u043e\u0449\u043d\u0435\u0435 \u041f\u0440\u0438\u0437\u043c\u044b, \u043a\u043d\u043e\u043f\u043a\u0438 \u00ab\u0429\u0438\u0442\u00bb \u0438 \u00ab\u041d\u043e\u0432\u0430\u00bb"

    const-string v10, "\u042d\u043a\u043b\u0438\u043f\u0441: \u043d\u0435\u0443\u044f\u0437\u0432\u0438\u043c 2 \u0441 \u043f\u043e\u0441\u043b\u0435 \u0443\u0434\u0430\u0440\u0430, \u043a\u043d\u043e\u043f\u043a\u0438 \u00ab\u0429\u0438\u0442\u00bb \u0438 \u00ab\u041d\u043e\u0432\u0430\u00bb"

    const-string v11, "\u041e\u043c\u0435\u0433\u0430: \u0441\u0438\u043b\u044c\u043d\u0435\u0439\u0448\u0438\u0439 \u043a\u043e\u0440\u0430\u0431\u043b\u044c, \u0437\u043e\u043b\u043e\u0442\u043e \u00d71,7, \u043a\u043d\u043e\u043f\u043a\u0438 \u00ab\u0429\u0438\u0442\u00bb \u0438 \u00ab\u041d\u043e\u0432\u0430\u00bb"

    const-string v12, "\u041d\u0435\u0439\u0442\u0440\u043e\u043d: \u0438\u043e\u043d\u043d\u044b\u0435 \u043f\u043b\u0430\u0432\u043d\u0438\u043a\u0438, \u0437\u043e\u043b\u043e\u0442\u043e \u00d71,8, \u043a\u043d\u043e\u043f\u043a\u0438 \u00ab\u0429\u0438\u0442\u00bb \u0438 \u00ab\u041d\u043e\u0432\u0430\u00bb \u2014 \u043a\u043e\u0440\u0430\u0431\u043b\u044c \u0434\u043b\u044f \u041c\u0438\u0440\u0430 6"

    const-string v13, "\u0413\u043e\u0440\u0438\u0437\u043e\u043d\u0442: \u0448\u0438\u0440\u043e\u043a\u043e\u0435 \u0434\u0435\u043b\u044c\u0442\u0430-\u043a\u0440\u044b\u043b\u043e, \u0437\u043e\u043b\u043e\u0442\u043e \u00d71,9, \u043a\u043d\u043e\u043f\u043a\u0438 \u00ab\u0429\u0438\u0442\u00bb \u0438 \u00ab\u041d\u043e\u0432\u0430\u00bb"

    const-string v14, "\u0410\u0432\u0440\u043e\u0440\u0430: \u043a\u0440\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u043b\u0435\u043d\u0442\u044b-\u043a\u0440\u044b\u043b\u044c\u044f, \u0437\u043e\u043b\u043e\u0442\u043e \u00d72, \u043a\u043d\u043e\u043f\u043a\u0438 \u00ab\u0429\u0438\u0442\u00bb \u0438 \u00ab\u041d\u043e\u0432\u0430\u00bb"

    const-string v15, "\u0413\u0438\u043f\u0435\u0440\u0438\u043e\u043d: \u0442\u044f\u0436\u0451\u043b\u044b\u0439 \u043b\u0438\u043d\u043a\u043e\u0440, \u0437\u043e\u043b\u043e\u0442\u043e \u00d72,1, \u043a\u043d\u043e\u043f\u043a\u0438 \u00ab\u0429\u0438\u0442\u00bb \u0438 \u00ab\u041d\u043e\u0432\u0430\u00bb"

    const-string v16, "\u0410\u0431\u0441\u043e\u043b\u044e\u0442: \u0441\u0438\u043b\u044c\u043d\u0435\u0439\u0448\u0438\u0439 \u043a\u043e\u0440\u0430\u0431\u043b\u044c, \u0437\u043e\u043b\u043e\u0442\u043e \u00d72,2, \u043a\u043d\u043e\u043f\u043a\u0438 \u00ab\u0429\u0438\u0442\u00bb \u0438 \u00ab\u041d\u043e\u0432\u0430\u00bb \u2014 \u043a\u043e\u0440\u0430\u0431\u043b\u044c \u0434\u043b\u044f \u041c\u0438\u0440\u0430 7"

    const-string v17, "\u0421\u0438\u043d\u0433\u0443\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u044c: \u0444\u0438\u043e\u043b\u0435\u0442\u043e\u0432\u0430\u044f \u0442\u044c\u043c\u0430, \u043e\u0440\u0443\u0436\u0438\u0435 \u0432\u0442\u043e\u0440\u043e\u0433\u043e \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f"

    const-string v18, "\u0425\u0440\u043e\u043d\u043e\u0441: \u0437\u043e\u043b\u043e\u0442\u043e \u0438 \u043b\u0430\u0437\u0443\u0440\u044c, \u043e\u0440\u0443\u0436\u0438\u0435 \u0432\u0442\u043e\u0440\u043e\u0433\u043e \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f"

    const-string v19, "\u041d\u0435\u043a\u0441\u0443\u0441: \u0437\u0435\u043b\u0451\u043d\u043e-\u0431\u0435\u043b\u044b\u0439 \u0443\u0437\u0435\u043b, \u043e\u0440\u0443\u0436\u0438\u0435 \u0432\u0442\u043e\u0440\u043e\u0433\u043e \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f"

    const-string v20, "\u041f\u0440\u0435\u0434\u0435\u043b: \u0431\u0430\u0433\u0440\u043e\u0432\u044b\u0439, \u0441\u0438\u043b\u044c\u043d\u0435\u0439\u0448\u0438\u0439 \u043a\u043e\u0440\u0430\u0431\u043b\u044c \u0432\u0442\u043e\u0440\u043e\u0433\u043e \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f"

